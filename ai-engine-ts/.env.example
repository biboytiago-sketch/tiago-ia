# ⚠️ CHAVES OBRIGATÓRIAS
# Copie este arquivo para `.env` e preencha os valores.

# 🔑 Google Gemini (IA Geradora de Predições e Bilhetes)
# Gere em: https://aistudio.google.com/  (gratuita para uso pessoal, limite razoável)
# ATENÇÃO 2026: gemini-2.0-flash FOI DESCONTINUADO pela Google. Use gemini-3.6-flash.
GEMINI_API_KEY=

# (Opcional) Modelo Gemini a ser usado
#   - Recomendado:  gemini-3.6-flash          (padrão · rápido · 1M tokens janela)
#   - Barato:       gemini-2.5-flash-8b       (menos preciso, custo menor)
#   - Premium:      gemini-3.5-pro            (mais preciso, latencia pior e mais caro)
GEMINI_MODEL=gemini-3.6-flash

# (Opcional) Stake padrão em R$ (Reais) para cálculo de bilhete pronto
DEFAULT_STAKE_BRL=100

# (Opcional) Bankroll simulado (apenas para calculo de stake percentual)
BANKROLL_BRL=1000

# ============================================================
# CHAVES DAS FONTES DE DADOS (providerManager.ts fetcher real)
# - NEXT_PUBLIC_ prefixo usado em Next.js client (Server-Side Render / proxy)
# - Sem NEXT_PUBLIC_: usado em Node puro / ts-node / build dist
# - O providerManager.ts TENTA AMBOS automaticamente (primeiro com prefixo dps sem)
# ============================================================

# FONTES 1..4 (RapidAPI) — uma chave compartilhada por 4 hosts diferentes
RAPIDAPI_KEY=
# ou (Next.js client browser):
NEXT_PUBLIC_RAPIDAPI_KEY=

RAPIDAPI_HOST_FLASHLIVE=flashlive-sports.p.rapidapi.com
RAPIDAPI_HOST_FREEAPI=free-api-live-football-data.p.rapidapi.com
RAPIDAPI_HOST_LEGACY=api-football-v1.p.rapidapi.com
RAPIDAPI_HOST_FOOTBALL_PRO=football-pro.p.rapidapi.com

# FONTE 5 — API-Football DIRETO (apikey própria de api-football.com / api-sports.io)
API_FOOTBALL_KEY=
NEXT_PUBLIC_API_FOOTBALL_KEY=

# FONTE 6 — Football-Data.org (gratuita free tier)
FOOTBALL_DATA_ORG_KEY=
NEXT_PUBLIC_FOOTBALL_DATA_ORG_KEY=

# (Opcional) Proxy server-side para evitar CORS no browser.
#   Exemplo backend Python: http://127.0.0.1:8000/api/v3/sports/hoje
#   Se definido, providerManager.fetchTodayMatches() usa isso primeiro e ignora CORS browser.
PROXY_SPORTS_TODAY_URL=
NEXT_PUBLIC_PROXY_SPORTS_TODAY_URL=

